import java.util.Scanner;

public class Task2Ex13 {

    public static double readNumber(Scanner sc) {
        return sc.nextDouble();
    }

    public static boolean fits(double x, double y, double w, double h) {
        return (x <= w && y <= h) || (x <= h && y <= w);
    }

    public static boolean canPass(double a, double b, double c, double w, double h) {
        return fits(a, b, w, h) || fits(a, c, w, h) || fits(b, c, w, h);
    }

    public static void printResult(boolean result) {
        if (result) {
            System.out.println("Кирпич пройдет");
        } else {
            System.out.println("Кирпич не пройдет");
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double a = readNumber(sc);
        double b = readNumber(sc);
        double c = readNumber(sc);
        double w = readNumber(sc);
        double h = readNumber(sc);
        printResult(canPass(a, b, c, w, h));
    }
}